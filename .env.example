# =========================================================
# ViralCut Stage 1 Environment Config
# =========================================================

# ---------------------------------------------------------
# 火山方舟 Doubao API
# 注意：真实 API Key 不建议提交到 GitHub
# ---------------------------------------------------------
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=
DOUBAO_MODEL=Doubao-Seed-2.0-lite


# ---------------------------------------------------------
# ASR / Whisper 配置
# ---------------------------------------------------------

# Whisper 模型大小：
# tiny   = 最快，准确率较差
# base   = 快，中文一般
# small  = 推荐默认，速度和准确率平衡
# medium = 更准但更慢
# large  = 最准但本地很慢，不建议 MVP 默认
WHISPER_MODEL=small

# ASR 模式：
# safe = 保守模式，适合 BGM 重的视频；宁愿少识别，也不要乱输出
# normal = 普通模式，适合清晰口播视频
ASR_MODE=safe

# Whisper 推理类型：
# int8 = 推荐，速度快，内存低
# float16 = GPU/MPS 场景可尝试
# float32 = 最稳但慢
WHISPER_COMPUTE_TYPE=int8

# 语言设置：
# auto = 自动识别中英文，推荐
# zh = 强制中文，适合纯中文口播
# en = 强制英文，适合纯英文视频
ASR_LANGUAGE=auto


# ASR segment 过滤阈值：
# 越宽松保留越多内容，越严格过滤越多

# 最低平均 log 概率：
# -1.0 = 严格，过滤掉低置信片段
# -1.5 = 宽松，保留更多真实对白（推荐）
ASR_MIN_AVG_LOGPROB=-1.5

# 最大无语音概率：
# 0.65 = 严格，容易把弱人声过滤掉
# 0.8 = 宽松，保留BGM下的人声片段（推荐）
ASR_MAX_NO_SPEECH_PROB=0.8

# 最低语言检测置信度：
# 0.45 = 严格，中英混合视频可能被整体清空
# 0.3 = 宽松，允许语言检测不确定的情况（推荐）
ASR_MIN_LANGUAGE_PROBABILITY=0.3


# ---------------------------------------------------------
# OCR 主策略
# ---------------------------------------------------------

# OCR 方法：
# rapid = 只用本地 RapidOCR，最快，成本低，但复杂艺术字可能漏
# doubao = 只用 Doubao 多模态 OCR，最准但最慢、消耗 API
# rapid_then_doubao = 推荐默认，先用 RapidOCR，低质量/空结果时再用 Doubao fallback
# fast_hybrid = 旧版混合方案，不推荐继续作为默认
# tesseract = 本地开源 OCR，中文效果一般，不推荐
OCR_METHOD=rapid_then_doubao

# OCR 最大处理帧数：
# 0 = 不限制，处理所有 keyframes
# 12/20/30 = 限制最多处理多少帧，速度更快但可能漏内容
# 当前测试视频建议先用 0，保证证据完整
OCR_MAX_FRAMES=0

# Doubao batch 参数：
# 注意：之前 batch 会把第一张图文字套到后面图上，因此不建议 batch OCR
# 这里保留配置只是兼容旧逻辑
OCR_BATCH_SIZE=4
OCR_MAX_WORKERS=2

# 图像 hash 去重阈值：
# 数值越大，去重越激进
# 4 = 保守
# 5 = 推荐，能去掉更多相似帧
# 6+ = 可能误删相似但文字不同的帧
OCR_HASH_THRESHOLD=5

# ROI 区域 hash 去重阈值：
# 用于判断字幕区域/画面文字区域是否重复
# 5 推荐
OCR_ROI_HASH_THRESHOLD=5


# ---------------------------------------------------------
# RapidOCR 配置
# ---------------------------------------------------------

# RapidOCR 最低置信度：
# 0.45 = 更宽松，能保留更多文字，但误识别更多
# 0.55 = 推荐，速度快且质量较稳
# 0.65 = 更严格，可能漏掉低清文字
RAPID_OCR_MIN_CONF=0.55

# RapidOCR 空结果时是否 fallback 到 Doubao：
# true = 如果 RapidOCR 完全没识别到文字，则调用 Doubao
# false = 不 fallback，速度最快
# 当前建议 false，因为低质量 fallback 已经覆盖主要情况
RAPID_FALLBACK_ON_EMPTY=false

# RapidOCR 低质量时是否 fallback 到 Doubao：
# true = 推荐。标题帧、hook 帧、文字明显但 RapidOCR 质量差时调用 Doubao
# false = 完全依赖 RapidOCR，最快但质量下降
RAPID_FALLBACK_ON_LOW_QUALITY=true

# RapidOCR 质量分阈值：
# 低于该值时可能触发 Doubao fallback
# 0.35 = fallback 少，速度快
# 0.42 = 推荐平衡值
# 0.48 = fallback 更多，质量更好但更慢
RAPID_OCR_MIN_QUALITY_SCORE=0.42

# Doubao fallback 最大帧数：
# 限制最多多少帧可以调用 Doubao，防止 API 调用过多
# 8 = 快
# 12 = 推荐
# 20 = 更准但更慢
DOUBAO_FALLBACK_MAX_FRAMES=12


# ---------------------------------------------------------
# 水印过滤配置
# ---------------------------------------------------------

# 水印判断最小出现比例：
# 如果某段文字/位置在大量帧中重复出现，则可能是平台水印
# 0.35 = 推荐，适合抖音水印
# 0.5 = 更保守
OCR_WATERMARK_MIN_RATIO=0.35

# 水印判断最小出现次数：
# 至少出现多少次才认为可能是水印
# 5 = 推荐
# 3 = 更激进，可能误删重复字幕
OCR_WATERMARK_MIN_COUNT=5


# ---------------------------------------------------------
# Stage 2: LLM 配置
# ---------------------------------------------------------

# LLM 提供商：doubao / openai / deepseek / moonshot
LLM_PROVIDER=doubao

# 如果用 doubao，会自动读取 DOUBAO_API_KEY 和 DOUBAO_ENDPOINT
# 如果要换其他提供商，设置以下变量：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o

# LLM 温度（低温度 = 更确定性的输出，推荐 0.1）
LLM_TEMPERATURE=0.1

# LLM 请求超时（秒）
LLM_TIMEOUT=120


# ---------------------------------------------------------
# Stage 2: 视觉 API 预算
# ---------------------------------------------------------

# 全局最多调用多少次 look_at_keyframe（Doubao 多模态）
STAGE2_VISION_MAX_CALLS_TOTAL=16

# 每个 Agent 最多调用多少次
STAGE2_VISION_MAX_CALLS_PER_AGENT=4


# =========================================================
# Link pipeline (src/stage1/link_pipeline) 配置
# =========================================================

# 分析输出目录（JSON、关键帧、临时音频）
OUTPUT_DIR=./output

# yt-dlp 使用的 Netscape 格式 cookie 文件路径
# 抖音/小红书等需要登录或有年龄限制的内容时需要；不需要可留空
COOKIE_FILE=

# OpenRouter API key —— link pipeline 的 VLM 关键帧描述（--vlm-model）需要
OPENROUTER_API_KEY=