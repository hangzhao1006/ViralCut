# Copy this file to .env and fill in your values.

# Root directory where analysis outputs (JSON, keyframes, temp audio) are saved.
OUTPUT_DIR=./output

# Path to a Netscape-format cookie file for yt-dlp.
# Required for age-restricted or login-gated content (Douyin, Xiaohongshu, etc.).
# Leave blank if not needed.
COOKIE_FILE=
