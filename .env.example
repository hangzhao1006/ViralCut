# 火山方舟 Doubao API
DOUBAO_API_KEY=your_api_key_here
DOUBAO_ENDPOINT=your_endpoint_here
DOUBAO_MODEL=

# Whisper 模型大小: tiny / base / small / medium / large
WHISPER_MODEL=base

# OCR 方式: llm（用Doubao多模态，推荐） / tesseract（本地，中文差）
OCR_METHOD=fast_hybrid
OCR_MAX_FRAMES=0
OCR_BATCH_SIZE=4
OCR_MAX_WORKERS=2
OCR_HASH_THRESHOLD=4